# Set this to your backend API URL
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Production (Vercel backend):
# NEXT_PUBLIC_API_URL=https://your-backend.vercel.app/api

# Must match the backend JWT_SECRET (used by middleware.js to verify auth cookies)
# IMPORTANT: set this in your Vercel project env for the frontend (server-side only, NOT NEXT_PUBLIC)
JWT_SECRET=your_random_min_32_char_secret